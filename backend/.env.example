# Copy to backend/.env  (never commit .env)
# The Java service is the ONLY place Fiserv and Plaid secrets live.

PORT=8081
BIND_HOST=127.0.0.1
# Must match BACKEND_SHARED_SECRET in web/.env.local. Generate: openssl rand -hex 32
BFF_SHARED_SECRET=dev-only-change-me

# ---------------- Fiserv Banking Hub ----------------
# mock = in-memory Premier-like core (works offline). live = your Developer Studio workspace.
FISERV_MODE=mock
# From Developer Studio > Workspaces > your workspace > Credentials tab:
FISERV_API_KEY=
FISERV_API_SECRET=
FISERV_ORG_ID=
# "Host URL" on the Credentials tab (Trial plan = shared Premier sandbox):
FISERV_HOST_URL=https://bankinghub-cert.fiservapis.com/banking/efx/v1
FISERV_TOKEN_URL=https://bankinghub-cert.fiservapis.com/fts-apim/oauth2/v2
# Optional EFXHeader fields
FISERV_VENDOR_ID=
FISERV_CHANNEL=WEB
FISERV_CLIENT_APP_NAME=PSK-Bank-Online-Demo

# Demo customers and the core accounts each one is entitled to: TYPE:ACCTID:Nickname;...  TYPE = DDA | SDA | CDA
# In live mode use accounts that exist in the Banking Hub sandbox (Resources > Postman collection has sample AcctIds).
DEMO_USERS=u-alex:Alex Morgan,u-jordan:Jordan Lee,u-sam:Sam Patel
ACCOUNTS_u-alex=DDA:4100011111:Everyday Checking;SDA:4100067890:Money Market;CDA:6200045678:12-Month CD
ACCOUNTS_u-jordan=DDA:4100022222:Everyday Checking;SDA:4100012345:High-Yield Savings
ACCOUNTS_u-sam=DDA:4100033333:Everyday Checking

TRANSFER_LIMIT_USD=25000
# Sending to another PSK Bank customer
MEMBER_TRANSFER_LIMIT_USD=5000
MEMBER_DAILY_LIMIT_USD=10000
# Velocity: money movements per customer per minute
TRANSFERS_PER_MINUTE=6

# ---------------- Plaid ----------------
# mock = built-in sandbox look-alike. live = real Plaid (use PLAID_ENV=sandbox with sandbox keys).
PLAID_MODE=mock
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_CLIENT_NAME=PSK Bank Online Banking Demo
ACH_FUNDING_LIMIT_USD=10000
