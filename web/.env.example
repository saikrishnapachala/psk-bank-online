# Copy to web/.env.local  (never commit it)
# The web tier holds NO Fiserv or Plaid secrets. It only knows how to reach the Java service.

# Java banking service (private network in production; localhost for the demo)
BACKEND_URL=http://127.0.0.1:8081
# Must equal BFF_SHARED_SECRET in backend/.env
BACKEND_SHARED_SECRET=dev-only-change-me

# Signs the session cookie. Generate: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string-for-local-dev-0123456789

# Demo login (test-only values). Production replaces this with OIDC + MFA from your identity provider.
DEMO_PASSWORD=psk-demo-2026
# username:user-id:display name. User ids must match DEMO_USERS in backend/.env.
DEMO_USERS=alex:u-alex:Alex Morgan,jordan:u-jordan:Jordan Lee,sam:u-sam:Sam Patel
